# Backend environment — copy to backend/.env and adjust if needed
DATABASE_URL=postgresql+asyncpg://couple:couple@db:5432/couple_calendar
DATABASE_URL_SYNC=postgresql://couple:couple@db:5432/couple_calendar

# IMPORTANT: change this to a long random string in any shared/remote setup
SECRET_KEY=change-me-please-use-a-long-random-secret

MAGIC_LINK_EXPIRE_MINUTES=15
ACCESS_TOKEN_EXPIRE_MINUTES=43200
FRONTEND_URL=http://localhost:3000
